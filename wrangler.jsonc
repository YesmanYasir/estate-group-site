{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "estate-group-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "estate-group", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "PROPERTY_MEDIA", "bucket_name": "estate-group-media" }]
}
